# Copy to .env and fill in. Never commit .env.
# Generate the two secrets with:  openssl rand -hex 32

# Postgres password for the bundled `db` service. The app's DATABASE_URL is
# assembled from this in docker-compose.yml.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# Payload encryption/JWT secret. Changing it invalidates existing sessions.
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32

# Public base URL. Becomes NEXT_PUBLIC_SERVER_URL, which is baked into the
# bundle at build time — change it and rebuild, don't just restart.
# http://<server-ip> for now; https://sukhbaatarungu.com once DNS points here.
SERVER_URL=http://localhost

# --- Non-Docker / Vercel only ---------------------------------------------
# Used when running `npm run dev` directly against a local Postgres:
# DATABASE_URL=postgres://payload:payload@localhost:5432/payload
#
# Optional. When set, uploads go to Vercel Blob instead of the local `media`
# volume. Leave empty for the VPS deployment.
# BLOB_READ_WRITE_TOKEN=
